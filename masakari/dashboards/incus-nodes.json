    },
    {
      "type": "timeseries",
      "title": "Stale and stacked instances",
      "description": "Instances bound to a dead LXCFS mount, and instances whose AppArmor label stacks unconfined, per node.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_instances_state{node=~\"$node\",state=\"stale\"})",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} LXCFS stale"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_instances_confinement{node=~\"$node\",state=\"stacked\"})",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} AppArmor stacked"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "state-timeline",
      "title": "LXCFS and incusd",
      "description": "Host LXCFS answering, and incusd bound to the mount the host serves. A gap in incusd's view after an LXCFS restart closes when its liveness probe replaces the incusd container.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_host_lxcfs_up{node=~\"$node\"})",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} host LXCFS"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_incusd_lxcfs_fresh{node=~\"$node\"})",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} incusd view"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "clamp_max(sum by (node) (increase(incus_exporter_host_lxcfs_device_changes_total{node=~\"$node\"}[5m])), 1) * -1 + 1",
          "refId": "C",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} no LXCFS restart (5m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ok",
                  "color": "green"
                },
                "0": {
                  "text": "problem",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "type": "row",
      "title": "Instances",
      "id": 5,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Incus instances",
      "description": "Every running instance the exporter judged, with its Nova instance. Resource columns are the official Incus metrics. Click an instance name to open it in the official Incus dashboard.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, incus_instance, nova_uuid) (incus_exporter_instance_lxcfs_stale{node=~\"$node\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, incus_instance, nova_uuid) (incus_exporter_instance_apparmor_stacked{node=~\"$node\"})",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, incus_instance, nova_uuid) (label_replace(1 - incus_memory_MemAvailable_bytes{node=~\"$node\"} / incus_memory_MemTotal_bytes{node=~\"$node\"}, \"incus_instance\", \"$1\", \"name\", \"(.+)\") * on (node, incus_instance) group_left (nova_uuid) group by (node, incus_instance, nova_uuid) (incus_exporter_instance_apparmor_stacked{node=~\"$node\"}))",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, incus_instance, nova_uuid) (label_replace(1 - incus_filesystem_avail_bytes{node=~\"$node\",mountpoint=\"/\"} / incus_filesystem_size_bytes{node=~\"$node\",mountpoint=\"/\"}, \"incus_instance\", \"$1\", \"name\", \"(.+)\") * on (node, incus_instance) group_left (nova_uuid) group by (node, incus_instance, nova_uuid) (incus_exporter_instance_apparmor_stacked{node=~\"$node\"}))",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, incus_instance, nova_uuid) (label_replace(incus_procs_total{node=~\"$node\"}, \"incus_instance\", \"$1\", \"name\", \"(.+)\") * on (node, incus_instance) group_left (nova_uuid) group by (node, incus_instance, nova_uuid) (incus_exporter_instance_apparmor_stacked{node=~\"$node\"}))",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, incus_instance, nova_uuid) (label_replace(increase(incus_memory_OOM_kills_total{node=~\"$node\"}[24h]), \"incus_instance\", \"$1\", \"name\", \"(.+)\") * on (node, incus_instance) group_left (nova_uuid) group by (node, incus_instance, nova_uuid) (incus_exporter_instance_apparmor_stacked{node=~\"$node\"}))",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, incus_instance, nova_uuid) (incus_notifier_instance_awaiting_manual{node=~\"$node\"}) or max by (node, incus_instance, nova_uuid) (incus_exporter_instance_apparmor_stacked{node=~\"$node\"}) * 0",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "node": "Node",
              "incus_instance": "Instance",
              "nova_uuid": "Nova UUID",
              "Value #A": "LXCFS",
              "Value #B": "AppArmor",
              "Value #C": "Memory used",
              "Value #D": "Root disk used",
              "Value #E": "Processes",
              "Value #F": "OOM kills 24h",
              "Value #G": "Awaiting manual"
            },
            "indexByName": {
              "Node": 0,
              "Instance": 1,
              "Nova UUID": 2,
              "LXCFS": 3,
              "AppArmor": 4,
              "Memory used": 5,
              "Root disk used": 6,
              "Processes": 7,
              "OOM kills 24h": 8,
              "Awaiting manual": 9
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Node",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
