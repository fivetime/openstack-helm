{
  "uid": "incus-nodes-autoheal",
  "title": "Incus nodes and self-healing",
  "description": "Per-node LXCFS, AppArmor and self-healing state of the Incus computes, from the masakari Incus exporter and notifier, next to the official Incus metrics.",
  "tags": [
    "incus",
    "masakari"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "Incus (official)",
      "type": "link",
      "url": "/d/incus-official/incus",
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(incus_exporter_last_sweep_timestamp_seconds, node)",
          "refId": "node"
        },
        "definition": "label_values(incus_exporter_last_sweep_timestamp_seconds, node)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Nodes",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Incus nodes",
      "description": "One row per Incus compute. LXCFS and incusd columns come from the masakari Incus exporter, instance counts too; Recovery is the notifier's mode on the node, Withheld the number of reasons it is holding recoveries back for.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_instances_running{node=~\"$node\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_instances_state{node=~\"$node\",state=\"stale\"})",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_instances_confinement{node=~\"$node\",state=\"stacked\"})",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_host_lxcfs_up{node=~\"$node\"})",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_incusd_lxcfs_fresh{node=~\"$node\"})",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_incusd_launches_stacked{node=~\"$node\"})",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_exporter_host_lxcfs_start_time_seconds{node=~\"$node\"}) * 1000",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node) (incus_notifier_dry_run{node=~\"$node\"})",
          "refId": "H",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (node) (incus_notifier_autoheal_blocked{node=~\"$node\"})",
          "refId": "I",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count by (node) (incus_notifier_instance_awaiting_manual{node=~\"$node\"} == 1) or max by (node) (incus_notifier_dry_run{node=~\"$node\"}) * 0",
          "refId": "J",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - max by (node) (incus_exporter_last_sweep_timestamp_seconds{node=~\"$node\"})",
          "refId": "K",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "node": "Node",
              "Value #A": "Running",
              "Value #B": "LXCFS stale",
              "Value #C": "AppArmor stacked",
              "Value #D": "Host LXCFS",
              "Value #E": "incusd LXCFS view",
              "Value #F": "New instances",
              "Value #G": "LXCFS started",
              "Value #H": "Recovery",
              "Value #I": "Withheld",
              "Value #J": "Awaiting manual",
              "Value #K": "Last probe"
            },
            "indexByName": {
              "Node": 0,
              "Running": 1,
              "LXCFS stale": 2,
              "AppArmor stacked": 3,
              "Host LXCFS": 4,
              "incusd LXCFS view": 5,
              "New instances": 6,
              "LXCFS started": 7,
              "Recovery": 8,
              "Withheld": 9,
              "Awaiting manual": 10,
              "Last probe": 11
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "LXCFS stale"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "AppArmor stacked"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
